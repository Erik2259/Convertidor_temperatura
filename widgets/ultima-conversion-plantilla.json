{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    { "type": "TextBlock", "text": "Última conversión", "weight": "Bolder", "size": "Medium", "wrap": true },
    { "type": "TextBlock", "text": "${resultado}", "size": "ExtraLarge", "weight": "Bolder", "color": "Accent", "wrap": true },
    {
      "type": "FactSet",
      "facts": [
        { "title": "Entrada", "value": "${entrada}" },
        { "title": "Actualizado", "value": "${actualizado}" }
      ]
    }
  ],
  "actions": [
    { "type": "Action.Execute", "title": "Nueva conversión", "verb": "nueva" },
    { "type": "Action.Execute", "title": "Abrir", "verb": "abrir" }
  ]
}
